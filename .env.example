# Copy to .env for local development. All variables are optional.

# Highest tier of tool to register: read_only | proposes_action | executes_action
FLEETALERT_MCP_TIER=read_only

# FleetAlert API. Default is the live demo; point at a local backend if you run one.
# FLEETALERT_MCP_API_BASE_URL=http://localhost:8000

# HTTP mode only. client_id:tier:secret, comma separated, secrets 16+ characters.
# FLEETALERT_MCP_TOKENS=ops:executes_action:CHANGE-ME-32-random-chars,ci:read_only:CHANGE-ME-too

# HTTP mode only. Public URL for the protected-resource metadata.
# FLEETALERT_MCP_PUBLIC_URL=https://mcp.example.com

# Rate limits
# FLEETALERT_MCP_CALLS_PER_MINUTE=30
# FLEETALERT_MCP_ACTIONS_PER_HOUR=6
# FLEETALERT_MCP_UPSTREAM_CALLS_PER_MINUTE=120
